{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "web-app",
    "ignore": ["firebase.json", ".firebaserc", "**/.*"],
    "headers": [
      {"source": "**/*.@(html|js|css)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
